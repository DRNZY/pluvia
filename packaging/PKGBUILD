# Maintainer: DRNZY <https://github.com/DRNZY>
pkgname=pluvia-bin
_pkgname=pluvia
pkgver=0.1.0
pkgrel=1
pkgdesc="Native Rainmeter skin engine and widget runtime for Linux (Wayland & X11)"
arch=('x86_64')
url="https://github.com/DRNZY/pluvia"
license=('MIT')
depends=(
    'cairo'
    'pango'
    'fontconfig'
    'gtk4'
    'libadwaita'
    'libx11'
    'libxext'
    'libxfixes'
    'pipewire'
)
makedepends=('cargo' 'git')
provides=('pluvia' 'pluvia-daemon' 'pluvia-cli' 'pluvia-studio')
conflicts=('pluvia')
source=("git+https://github.com/DRNZY/pluvia.git")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$srcdir/$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-targets
}

package() {
    cd "$srcdir/$_pkgname"
    
    install -Dm755 target/release/pluvia-cli "$pkgdir/usr/bin/pluvia"
    install -Dm755 target/release/pluvia-cli "$pkgdir/usr/bin/pluvia-cli"
    install -Dm755 target/release/pluvia-daemon "$pkgdir/usr/bin/pluvia-daemon"
    install -Dm755 target/release/pluvia-studio "$pkgdir/usr/bin/pluvia-studio"

    install -Dm644 packaging/pluvia.desktop "$pkgdir/usr/share/applications/pluvia-studio.desktop"
    install -Dm644 packaging/pluvia.service "$pkgdir/usr/lib/systemd/user/pluvia.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
