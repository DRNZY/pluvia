+#[tokio::test]
+async fn test_ipc_pubsub_notifications() {
+    let (tmp, _handle, _runtime) = start_test_server().await;
+    let skin_path = create_sample_skin(tmp.path(), "NotifySkin");
+
+    // Connect a subscriber stream
